---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---
<section class="page-hero">
  <div class="container">
    <div class="page-hero__text">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      {lede && <p class="lede"><slot name="lede">{lede}</slot></p>}
    </div>
  </div>
</section>

<style>
  .page-hero {
    padding-block: clamp(2.75rem, 2rem + 4vw, 5rem) clamp(1.5rem, 1rem + 2vw, 2.5rem);
    background: linear-gradient(180deg, var(--brand-050), var(--paper));
    border-bottom: 1px solid var(--line);
  }
  .page-hero__text { max-width: 52rem; }
  .page-hero h1 { margin-bottom: 0.35em; }
  .page-hero .lede { color: var(--text-soft); margin: 0; }
</style>
