---
// Sibling-page switcher: under the featured studies on /studies, under the hero on /registries.
const tabs = [
  { href: '/studies', label: 'Interventional studies' },
  { href: '/registries', label: 'Registries' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<nav class="portfolio-tabs" aria-label="Study portfolio sections">
  <div class="container">
    <ul>
      {tabs.map((t) => (
        <li>
          <a href={t.href} aria-current={path === t.href ? 'page' : undefined}>{t.label}</a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .portfolio-tabs { border-bottom: 1px solid var(--line); background: var(--paper); }
  .portfolio-tabs ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0.25rem;
    overflow-x: auto;
  }
  .portfolio-tabs a {
    display: block;
    padding: 0.95rem 1rem;
    margin-bottom: -1px;
    border-bottom: 2px solid transparent;
    color: var(--text-soft);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .portfolio-tabs a:hover { color: var(--brand-700); }
  .portfolio-tabs a[aria-current='page'] { color: var(--brand-700); border-bottom-color: var(--brand-600); }
</style>
