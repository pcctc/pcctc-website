---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { services, engagementModels } from '../lib/data';

const svc = services();
const models = engagementModels();
---

<Base
  title="Services"
  description="The PCCTC supports full-service study management and functional service provider (FSP) engagements across trial design, project management, data management, biostatistics, regulatory, monitoring, correlative science, registries, and more."
>
  <PageHero
    eyebrow="Services"
    title="The trusted CRO for oncology research"
    lede="The PCCTC supports both full-service study management and functional service provider (FSP) project support. Industry-grade services, global consortium engagement, and deep scientific expertise accelerate the activation, accrual, and completion of multicenter clinical studies."
  />

  <section class="section section--surface" id="engagement">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">How we engage</p>
          <h2>One partner, multiple ways to engage</h2>
        </div>
        <p class="measure section-head__lede">
          The PCCTC's collaboration models flex to match your program's scope, timeline, and
          internal capacity.
        </p>
      </div>
      <div class="grid grid--2 models">
        {models.map((m) => (
          <article class="card model">
            <h3>{m.title}</h3>
            <ul class="model__points">
              {m.points.map((p) => (
                <li><Icon name="check" size={18} /> <span>{p}</span></li>
              ))}
            </ul>
            <p class="model__note">{m.summary}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="services">
    <div class="container services-layout">
      <aside class="services-nav" aria-label="Services">
        <ul>
          {svc.map((s) => (
            <li><a href={`#${s.slug}`}>{s.title}</a></li>
          ))}
        </ul>
      </aside>

      <div class="services-list">
        {svc.map((s, i) => (
          <article class="service" id={s.slug}>
            <div class="service__num">{String(i + 1).padStart(2, '0')}</div>
            <div class="service__body">
              <h2>{s.title}</h2>
              <p class="service__summary">{s.summary}</p>
              <ul class="service__points">
                {s.points.map((p) => (
                  <li><Icon name="check" size={19} /> <span>{p}</span></li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container cta-row">
      <div>
        <h2>Let's advance your program</h2>
        <p class="lede">Talk with our team about study management, FSP support, or scientific collaboration.</p>
      </div>
      <a href="/partner" class="btn btn--primary">Partner with us <Icon name="arrow" size={17} /></a>
    </div>
  </section>
</Base>

<style>
  .section-head {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem 3rem;
    margin-bottom: clamp(2rem, 1.5rem + 1.5vw, 3rem);
    align-items: end;
  }
  .section-head__lede { color: var(--text-soft); margin: 0; }
  @media (min-width: 54rem) {
    .section-head { grid-template-columns: 1.3fr 1fr; }
  }
  .model { display: flex; flex-direction: column; gap: 0.9rem; }
  .model h3 { color: var(--ink-900); }
  .model__points { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; flex-grow: 1; }
  .model__points li { display: flex; gap: 0.6rem; align-items: flex-start; }
  .model__points svg { color: var(--brand-500); flex-shrink: 0; margin-top: 3px; }
  .model__points span { color: var(--text); font-size: 0.97rem; }
  .model__note { margin: 0; padding-top: 0.9rem; border-top: 1px solid var(--line); color: var(--text-soft); font-size: 0.92rem; font-style: italic; }

  .services-layout {
    display: grid;
    gap: clamp(2rem, 1rem + 4vw, 4rem);
    align-items: start;
  }
  @media (min-width: 60rem) {
    .services-layout { grid-template-columns: 16rem 1fr; }
    .services-nav { position: sticky; top: 6rem; }
  }
  .services-nav ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.15rem; }
  .services-nav a {
    display: block;
    padding: 0.5rem 0.75rem;
    border-left: 2px solid var(--line);
    color: var(--text-soft);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .services-nav a:hover { border-color: var(--brand-500); color: var(--brand-700); }
  @media (max-width: 60rem) { .services-nav { display: none; } }

  .services-list { display: grid; gap: clamp(2.5rem, 2rem + 2vw, 4rem); }
  .service {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem;
    scroll-margin-top: 6rem;
    padding-bottom: clamp(2.5rem, 2rem + 2vw, 4rem);
    border-bottom: 1px solid var(--line);
  }
  .service:last-child { border-bottom: none; padding-bottom: 0; }
  .service__num {
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: var(--brand-300);
    line-height: 1.4;
  }
  .service__body h2 { font-size: var(--step-2); margin-bottom: 0.5rem; }
  .service__summary { color: var(--text-soft); max-width: 60ch; }
  .service__points { list-style: none; margin: 1.25rem 0 0; padding: 0; display: grid; gap: 0.75rem; }
  .service__points li { display: flex; gap: 0.7rem; align-items: flex-start; }
  .service__points svg { color: var(--brand-500); flex-shrink: 0; margin-top: 3px; }
  .service__points span { color: var(--text); font-size: 0.97rem; }

  @media (max-width: 34rem) {
    .service { grid-template-columns: 1fr; gap: 0.5rem; }
    .service__num { font-size: 1.2rem; }
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2rem;
    align-items: center;
    justify-content: space-between;
  }
  .cta-row .lede { color: var(--text-soft); margin: 0.5rem 0 0; }
</style>
