---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found"
  description="The page you're looking for could not be found."
  noindex={true}
>
  <section class="section notfound">
    <div class="container">
      <p class="code">404</p>
      <h1>We couldn't find that page</h1>
      <p class="lede">
        The page you're looking for may have moved. Try one of these instead.
      </p>
      <div class="links">
        <a href="/" class="btn btn--primary">Home</a>
        <a href="/studies" class="btn btn--ghost">Studies</a>
        <a href="/services" class="btn btn--ghost">Services</a>
        <a href="/news" class="btn btn--ghost">News</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .notfound { text-align: center; padding-block: clamp(4rem, 3rem + 6vw, 8rem); }
  .code {
    font-family: var(--font-display);
    font-size: clamp(4rem, 3rem + 8vw, 8rem);
    color: var(--brand-200);
    line-height: 1;
    margin: 0;
  }
  .notfound h1 { margin: 0.5rem 0 1rem; }
  .notfound .lede { color: var(--text-soft); max-width: 34rem; margin-inline: auto; }
  .links { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; margin-top: 2rem; }
</style>
