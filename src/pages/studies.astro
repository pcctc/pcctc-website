---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PortfolioTabs from '../components/PortfolioTabs.astro';
import Icon from '../components/Icon.astro';
import { featuredStudies, activeStudies } from '../lib/data';

const featured = featuredStudies();
const accrualOrder = ['Open to accrual', 'In development', 'Closed to accrual', 'Pending closure'];
const accrualRank = (status?: string) => {
  const i = accrualOrder.indexOf(status ?? '');
  return i === -1 ? accrualOrder.length : i;
};
// `url` is an override; entries normally carry only the NCT number.
// sort() is stable, so the file's newest-first order holds within each accrual status.
const active = activeStudies()
  .map((s) => ({
    ...s,
    url: s.url || (s.nct ? `https://clinicaltrials.gov/study/${s.nct}` : undefined),
  }))
  .sort((a, b) => accrualRank(a.status) - accrualRank(b.status));

// Condition chips only appear once the portfolio spans more than one disease.
const conditions = new Set(active.map((s) => s.condition ?? 'Prostate cancer'));
const multiCondition = conditions.size > 1;

const jsonLd = active
  .filter((s) => s.nct)
  .map((s) => ({
    '@context': 'https://schema.org',
    '@type': 'MedicalStudy',
    name: s.title,
    studySubject: { '@type': 'MedicalCondition', name: s.condition ?? 'Prostate Cancer' },
    ...(s.phase ? { phase: s.phase } : {}),
    ...(s.url ? { url: s.url } : {}),
    identifier: {
      '@type': 'PropertyValue',
      propertyID: 'ClinicalTrials.gov',
      value: s.nct,
    },
  }));
---

<Base
  title="Studies"
  description="PCCTC trials span the disease continuum, from first-in-human phase 1 through international phase 3, alongside large-scale registries such as IRONMAN, strategically aligned with the most promising targets and biomarkers in development today."
  jsonLd={jsonLd}
>
  <PageHero
    eyebrow="Studies"
    title="Our study portfolio"
    lede="Our trials span the entire disease continuum, strategically aligned with the most promising targets and biomarkers in development today."
  />

  <section class="section">
    <div class="container">
      <p class="eyebrow">Featured studies</p>
      <h2 class="block-title">From first-in-human to real-world registry</h2>
      <div class="grid grid--3 feat-grid">
        {featured.map((s) => {
          const external = s.url.startsWith('http');
          return (
            <a href={s.url} rel={external ? 'noopener' : undefined} target={external ? '_blank' : undefined} class="card feat">
              {s.note && <span class="feat__tag">{s.note}</span>}
              <h3>{s.title}</h3>
              <div class="feat__foot">
                {s.nct && <span class="nct">{s.nct}</span>}
                <span class="link-arrow">
                  {external ? <>Visit <Icon name="external" size={14} /></> : <>View study <Icon name="arrow" size={14} /></>}
                </span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <PortfolioTabs />

  <section class="section section--surface">
    <div class="container">
      <p class="eyebrow">Active study portfolio</p>
      <h2 class="block-title">Active interventional studies</h2>
      <p class="portfolio-note">Studies open to accrual are listed first.</p>
      <ul class="portfolio">
        {active.map((s) => (
          <li class="study-row">
            <div class="study-row__main">
              <p class="study-row__title">{s.title}</p>
              <div class="study-row__tags">
                {s.phase && <span class="chip chip--phase">{s.phase}</span>}
                {s.status && (
                  <span class:list={['chip', 'chip--status', s.status === 'Open to accrual' && 'chip--open']}>
                    {s.status}
                  </span>
                )}
                {multiCondition && <span class="chip">{s.condition ?? 'Prostate cancer'}</span>}
                {s.note && <span class="chip">{s.note}</span>}
              </div>
            </div>
            {s.nct && s.url && (
              <a href={s.url} rel="noopener" target="_blank" class="study-row__nct">
                {s.nct} <Icon name="external" size={14} />
              </a>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .block-title { font-size: var(--step-2); margin-bottom: 1.5rem; }

  /* Four featured cards: 4-up on wide screens, 2x2 on tablets. */
  .feat-grid { grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }
  .portfolio-note { color: var(--text-muted); font-size: 0.9rem; margin: -0.75rem 0 1.25rem; }
  .feat { display: flex; flex-direction: column; gap: 0.8rem; text-decoration: none; color: inherit; }
  .feat:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); border-color: var(--brand-200); }
  .feat__tag {
    align-self: flex-start;
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--brand-700);
    background: var(--brand-050);
    padding: 0.28rem 0.6rem;
    border-radius: 999px;
  }
  .feat h3 { font-size: 1.1rem; color: var(--ink-900); line-height: 1.32; flex-grow: 1; }
  .feat__foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.25rem 1rem; }
  .feat .nct { font-size: 0.85rem; color: var(--text-muted); }
  .feat .link-arrow { color: var(--brand-600); font-size: 0.88rem; white-space: nowrap; }

  .portfolio { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; }
  .study-row {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    justify-content: space-between;
    padding: 1.25rem 1.4rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    transition: border-color 0.15s ease;
  }
  .study-row:hover { border-color: var(--brand-200); }
  .study-row__title { margin: 0 0 0.6rem; color: var(--ink-900); font-weight: 550; line-height: 1.45; }
  .study-row__tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-soft);
    background: var(--surface-2);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }
  .chip--phase { color: var(--brand-700); background: var(--brand-050); }
  .chip--status { background: transparent; border: 1px solid var(--line); }
  .chip--open { color: var(--brand-700); border-color: var(--brand-300); }
  .study-row__nct {
    flex-shrink: 0;
    white-space: nowrap;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--brand-600);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.15rem;
  }

  @media (max-width: 40rem) {
    .study-row { flex-direction: column; gap: 0.75rem; }
  }
</style>
