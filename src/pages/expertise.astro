---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { expertise, paragraphs } from '../lib/data';

const sections = expertise();
---

<Base
  title="Expertise"
  description="PCCTC investigators are internationally recognized leaders who developed the clinical states model of prostate cancer and led the endpoint-validation work behind PCWG2, PCWG3, and PCWG4."
>
  <PageHero
    eyebrow="Expertise"
    title="Deep scientific leadership in prostate cancer"
    lede="Our translational, team-based approach unites investigators from the world's leading academic medical centers around the co-development of therapies and biomarkers."
  />

  <section class="section">
    <div class="container expertise-page">
      <nav class="expertise-toc" aria-label="On this page">
        <ul>
          {sections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
        </ul>
      </nav>
      <div class="expertise-content prose">
        {sections.map((s) => (
          <article class="exp-section" id={s.id}>
            <h2>{s.title}</h2>
            {paragraphs(s.body).map((para) => <p>{para}</p>)}
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .expertise-page {
    display: grid;
    gap: clamp(2rem, 1rem + 4vw, 4rem);
    align-items: start;
  }
  @media (min-width: 60rem) {
    .expertise-page { grid-template-columns: 15rem 1fr; }
    .expertise-toc { position: sticky; top: 6rem; }
  }
  .expertise-toc ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.15rem; }
  .expertise-toc a {
    display: block;
    padding: 0.5rem 0.75rem;
    border-left: 2px solid var(--line);
    color: var(--text-soft);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
  }
  .expertise-toc a:hover { border-color: var(--brand-500); color: var(--brand-700); }
  @media (max-width: 60rem) { .expertise-toc { display: none; } }

  .exp-section { scroll-margin-top: 6rem; max-width: 68ch; }
  .exp-section + .exp-section { margin-top: 3rem; padding-top: 3rem; border-top: 1px solid var(--line); }
  .exp-section h2 { font-size: var(--step-2); }
  .exp-section p { color: var(--text-soft); }
</style>
